	end

JubilifeCity_JubilifeTV_F3_Text_Npc3:
	.string "Records are fine things.\nThey tell you the history of stuff.\pYou can really sense the dramatic\nstories behind all those numbers!$"

JubilifeCity_JubilifeTV_F3_EventScript_Npc4::
