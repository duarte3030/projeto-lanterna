	end

JubilifeCity_JubilifeTV_F3_Text_Npc4:
	.string "Hey, there!\nHow's it going?\pI'm a TV producer here.\nAre you watching TV?\pSo, let me ask you.\nWill you tell me your opinion on TV?$"
