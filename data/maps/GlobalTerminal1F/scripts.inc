GlobalTerminal1F_MapScripts::
	.byte 0

GlobalTerminal1F_EventScript_Npc1::
	msgbox GlobalTerminal1F_Text_Npc1, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc1:
	.string "Welcome! This is the Global Trade\nStation, or GTS for short.\pWe enable the trading of Pokémon with\npeople worldwide over Nintendo WFC.\pWould you like to do a global\nPokémon trade?$"

GlobalTerminal1F_EventScript_Npc2::
	msgbox GlobalTerminal1F_Text_Npc2, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc2:
	.string "Yo, yo, yo!\pWanna let the world know about you?\nThen you gotta tell me, yo!$"

GlobalTerminal1F_EventScript_Npc3::
	msgbox GlobalTerminal1F_Text_Npc3, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc3:
	.string "Hi, have you visited the Dress-Up\nData Studio?\pHave you put yours on exhibit?\nOr do you only look at other entries?\pWhether you're an exhibitor or viewer,\nI have a Backdrop for you!$"

@ Fala de NPC e de placa vinda do pokeplatinum (dev_scripts/texto_sinnoh.py)

GlobalTerminal1F_EventScript_Npc1::
	msgbox GlobalTerminal1F_Text_Npc1, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc1:
	.string "That's a big globe, eh?\pWhere do I live on it now?\nLet's see if I can point it out...$"

GlobalTerminal1F_EventScript_Npc2::
	msgbox GlobalTerminal1F_Text_Npc2, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc2:
	.string "They say if you communicate with\nsomeone, their location is\precorded on this giant globe.$"

GlobalTerminal1F_EventScript_Npc3::
	msgbox GlobalTerminal1F_Text_Npc3, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc3:
	.string "All I need to do is leave a Pokémon\nhere to trade.\pWho knows, it might be traded while\nI'm asleep tonight.$"

GlobalTerminal1F_EventScript_Npc4::
	msgbox GlobalTerminal1F_Text_Npc4, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc4:
	.string "You can easily trade Pokémon with\nPokémon fans around the world.\pIsn't that something?$"

GlobalTerminal1F_EventScript_Npc5::
	msgbox GlobalTerminal1F_Text_Npc5, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc5:
	.string "You can register where you live on\nthis giant globe.\pOnce you do, you can show your location\nto anyone you communicate with.$"

GlobalTerminal1F_EventScript_Npc6::
	msgbox GlobalTerminal1F_Text_Npc6, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc6:
	.string "Is Nintendo WFC something even I\ncan use easily?\pIf it is really that easy, I'd love\nto trade Pokémon, too!$"

GlobalTerminal1F_EventScript_Npc7::
	msgbox GlobalTerminal1F_Text_Npc7, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc7:
	.string "There are several portal machines here\nat the Global Terminal.\pYou must set your Vs. Recorder in\nthe machines for communication.\pPlease do give the machines a try, as\nthey guide you through the operation.$"

GlobalTerminal1F_EventScript_Npc8::
	msgbox GlobalTerminal1F_Text_Npc8, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc8:
	.string "Welcome to the Global Terminal!\pHere, you may join the huge community\nof Trainers worldwide.\pYou may view the records of Trainers\nlike yourself from around the world.\pYou may also trade Pokémon with the\nworld's Trainers.$"

GlobalTerminal1F_EventScript_Npc9::
	msgbox GlobalTerminal1F_Text_Npc9, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc9:
	.string "This week, I'll do it!\pI really want to make the Top 8 of the\nrankings.$"

GlobalTerminal1F_EventScript_Npc10::
	msgbox GlobalTerminal1F_Text_Npc10, MSGBOX_NPC
	end

GlobalTerminal1F_Text_Npc10:
	.string "The Global Terminal has three floors.\pYou use warp panels for getting from\none floor to another.\pA blue panel takes you to the GTS on\nthe ground floor.\pTake a green panel to the studios for\nBox Data and Dress-Up Data on 2F.\pTake a pink warp panel to the third\nfloor for the Battle Video Gallery.$"

