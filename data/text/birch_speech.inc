@ Abertura de Sinnoh. Os simbolos continuam com o nome gText_Birch_* porque
@ src/main_menu.c os chama por nome; so o texto mudou, para as falas do
@ Professor Rowan em Pokemon Platinum (res/text/rowan_intro.json, pokeplatinum).

gText_Birch_Welcome::
	.string "Hello there!\p"
	.string "It's so very nice to meet you!\p"
	.string "Welcome to the world of POKéMON!\p"
	.string "My name is ROWAN.\p"
	.string "However, everyone just calls me\n"
	.string "the POKéMON PROFESSOR.\p"
	.string "$"

gText_Birch_Pokemon::
	.string "This is what we call a “POKéMON.”\p"
	.string "\n"
	.string "$"

gText_Birch_MainSpeech::
	.string "This world is widely inhabited by\n"
	.string "creatures known as POKéMON.\p"
	.string "We humans live alongside POKéMON\n"
	.string "as friends.\p"
	.string "At times we play together, and at\n"
	.string "other times we work together.\p"
	.string "Some people use their POKéMON to\n"
	.string "battle and develop closer bonds\l"
	.string "with them.\p"
	.string "What do I do?\p"
	.string "I conduct research so that we may\n"
	.string "learn more about POKéMON.\p"
	.string "$"

gText_Birch_AndYouAre::
	.string "Now, why don't you tell me a\n"
	.string "little bit about yourself?$"

gText_Birch_BoyOrGirl::
	.string "Are you a boy?\n"
	.string "Or are you a girl?$"

gText_Birch_WhatsYourName::
	.string "Tell me, what is your name?$"

gText_Birch_SoItsPlayer::
	.string "Your name is {PLAYER}{KUN}?$"

gText_Birch_YourePlayer::
	.string "OK...\p"
	.string "So, you're {PLAYER}{KUN}?\p"
	.string "A fine name that is!\p"
	.string "$"

gText_Birch_AreYouReady::
	.string "All right, {PLAYER}{KUN}, the time\n"
	.string "has come.\p"
	.string "Your very own tale of grand\n"
	.string "adventure is about to unfold.\p"
	.string "On your journey, you will meet\n"
	.string "countless POKéMON and people.\p"
	.string "I'm sure that along the way you\n"
	.string "will discover many things, perhaps\l"
	.string "even something about yourself.\p"
	.string "Now, go on, leap into the world of\n"
	.string "POKéMON!\p"
	.string "$"
